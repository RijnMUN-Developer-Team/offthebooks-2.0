{
  "name": "rijnmun-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@netlify/functions": "^6.0.0",
    "@netlify/vite-plugin": "^3.0.1",
    "@vitejs/plugin-react": "5.0.4",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.3",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
